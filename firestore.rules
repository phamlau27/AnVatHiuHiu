rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: anyone can read, only admin (authenticated) can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Orders: anyone can create, only admin can read/update
    match /orders/{orderId} {
      // Allow anonymous users to create orders (with size limits)
      allow create: if request.resource.data.keys().hasAll([
        'customerName', 'phone', 'type', 'items', 'totalPrice', 'status', 'createdAt'
      ])
      && request.resource.data.items is list
      && request.resource.data.items.size() <= 50
      && request.resource.data.customerName is string
      && request.resource.data.customerName.size() <= 100
      && request.resource.data.phone is string
      && request.resource.data.phone.size() <= 20
      && request.resource.data.status == 'new';

      // Allow reading individual orders (for order history by ID)
      allow get: if true;

      // Only admin can list all orders or delete
      allow list, delete: if request.auth != null;

      // Admin can update anything. Anonymous can ONLY cancel a "new" order.
      allow update: if request.auth != null || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          resource.data.status == 'new' &&
          request.resource.data.status == 'cancelled'
        );
    }
  }
}
